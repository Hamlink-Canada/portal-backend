PORTAL_DISPLAY_NAME=Portal
PORTAL_CONFIG_DIR=.
PORTAL_ENVIRONMENT=production
PORTAL_DEV_MODE=false
PORTAL_DATABASE_URL=sqlite:///portal.db
PORTAL_BIND_HOST=127.0.0.1
PORTAL_BIND_PORT=5000
PORTAL_OIDC_ISSUER=https://identity.example.invalid/realms/example
# Optional override; otherwise discovered from the issuer's OIDC metadata.
PORTAL_OIDC_JWKS_URL=
PORTAL_API_AUDIENCE=portal-api
PORTAL_JWT_ALGORITHMS=RS256
PORTAL_REGISTRATION_LIFETIME_SECONDS=
# Optional replacement for the bundled country-to-Site Code mapping seeded
# from the legacy portal's sitecodes.json.
PORTAL_SITE_CODES_FILE=
# Set these to the provider claim and value used for System Super Admins.
PORTAL_SYSTEM_SUPER_ADMIN_CLAIM_PATH=realm_access.roles
PORTAL_SYSTEM_SUPER_ADMIN_CLAIM_VALUE=System Super Admin
